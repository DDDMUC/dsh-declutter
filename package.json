{
  "name": "dsh-declutter",
  "version": "0.1.1",
  "description": "DSH 界面收纳插件：把已经失败却后来成功的轮次、空轮、编辑产生的合成轮收起来——只改视图属性，完全可逆，绝不改会话日志；规则表化 + 逐条自检。",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./rules": "./src/logic.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "declutter",
    "view",
    "rule-table"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test \"test/*.test.js\""
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-trajectory"
      ]
    },
    "engines": {
      "dsh": ">=0.1.6-alpha.2"
    }
  }
}
