{
  "name": "dsh-declutter",
  "version": "0.3.0",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "sidebar"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "author": {
    "name": "DDDMUC",
    "email": "175344510+DDDMUC@users.noreply.github.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DDDMUC/dsh-sidebar-declutter.git"
  },
  "homepage": "https://github.com/DDDMUC/dsh-sidebar-declutter#readme",
  "bugs": {
    "url": "https://github.com/DDDMUC/dsh-sidebar-declutter/issues"
  }
}
